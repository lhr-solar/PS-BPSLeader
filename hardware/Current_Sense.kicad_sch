	(text "0A\nVout+ = 1.650V, \nVout- = 1.650V \nVdiff = 0V\nShunt_ADC = 1.650V"
		(exclude_from_sim no)
		(at 70.485 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0b277638-5de7-49ab-b3bb-d1dec53167b5")
	)
	(text "Unity Gain to Prevent Vin- Tapping into a live node"
		(exclude_from_sim no)
		(at 234.95 87.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "142491df-875a-4f7c-9503-62b34eaa0d1a")
	)
	(text "Discharge: \nVin+ = Vin- + V_bench = 1.65V + V_bench\nScurt_Vout = Vin- + (Vin+ − Vin-) × R2/(R1+R2)\n           = 1.65V + V_bench × (10k/100k)\n           = 1.65V + 0.1 × V_bench\nFor 70A: 0.1 × V_bench = 0.875V\nV_bench = 8.75V"
		(exclude_from_sim no)
		(at 68.707 177.165 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1c8db1de-422d-4e58-a746-305e24a7de0c")
	)
	(text "Sensitivity: 12.5mV/A\n\nCommon mode = 1.44V from sensor\n\nOp-amp common monde = 1.65V\n\nV_diff = I_input * 0.0125V/A\nVout+ = 1.65 + V_diff/2\nVout- = 1.65 - V_diff/2\n\nOp-amp gain = 1.0\n"
		(exclude_from_sim no)
		(at 86.36 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2cf44575-862a-4d1b-87db-1e6c4952df6e")
	)
	(text "V(bias) = Vcc/2 = 3.3/2 = 1.65V\n1.65 = 3.3 * (R40/R40+R39) = 0.5V\nR(bias) = must maintain gain of 1"
		(exclude_from_sim no)
		(at 91.44 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4038d9fa-593b-473d-afd9-07aa276b3460")
	)
	(text "Charge:\nVin+ = Vin- − V_bench = 1.65V − V_bench\nScurt_Vout = 1.65V − 0.1 × V_bench\nFor -40A: 0.1 × V_bench = 0.5V\nV_bench = 5V"
		(exclude_from_sim no)
		(at 125.603 176.911 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4b59e5dd-e2de-458b-9df8-342ab0eb1a0e")
	)
